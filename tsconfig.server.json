{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["src/core/**/*", "src/server/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
