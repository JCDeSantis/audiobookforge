# Code-signing identity from Keychain.
# Find yours: security find-identity -v -p codesigning | grep "Developer ID Application"
CSC_NAME=Developer ID Application: Your Name (TEAMID)

# Notarization — optional. When set, the DMG passes Gatekeeper on macOS 12+ without
# requiring right-click → Open. Obtain an app-specific password at appleid.apple.com.
# APPLE_ID=your@apple.id
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX
