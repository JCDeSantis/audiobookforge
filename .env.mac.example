# Copy this file to .env.mac and fill in your values.
# .env.mac is gitignored — never commit it.
#
# Find your CSC_NAME:
#   security find-identity -v -p codesigning | grep "Developer ID Application"

CSC_NAME="Developer ID Application: Your Name (TEAMID)"

# Optional — only needed for notarization (stapling the ticket to the DMG)
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX
